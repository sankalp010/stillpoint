{
  "name": "mock-interview-platform",
  "private": true,
  "workspaces": ["api", "web"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace api run dev",
    "dev:web": "npm --workspace web run dev",
    "build": "npm --workspace web run build",
    "lint": "npm --workspace web run lint && npm --workspace api run lint",
    "test": "npm --workspace api test",
    "seed": "npm --workspace api run seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
